{
  "$schema": "https://metis.local/schemas/tool-manifest-v1.json",
  "schema_version": "1",
  "id": "reference-architecture-generator",
  "display_name": "Reference Architecture Generator",
  "description": "Render a validated architecture specification as deterministic Python diagrams code, SVG, and PNG artifacts.",
  "version": "0.3.0",
  "state": "quarantined",
  "entrypoint": {
    "kind": "podman",
    "image": "localhost/metis/reference-architecture-tool:0.3.0",
    "protocol": "json-stdio-v1",
    "host_runner": "infra/sandbox/run_reference_architecture.py"
  },
  "permissions": {
    "risk_level": "R2",
    "network": "none",
    "model_access": false,
    "secrets": false,
    "host_shell": false,
    "filesystem": {
      "input": "read-only",
      "output": "read-write-run-artifacts-only",
      "root_filesystem": "read-only"
    },
    "activation_requires_human_approval": true
  },
  "limits": {
    "cpus": 2.0,
    "memory_mib": 1536,
    "pids": 64,
    "timeout_seconds": 120,
    "max_stdin_bytes": 1048576,
    "max_diagram_code_bytes": 100000,
    "max_logs_bytes": 20971520,
    "max_artifacts_bytes": 104857600
  },
  "dependencies": {
    "python": "3.13.5",
    "base_image": "docker.io/library/python:3.13.5-slim-bookworm@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419",
    "lockfile": "requirements-runtime.lock",
    "python_packages": [
      "diagrams==0.25.1",
      "graphviz==0.20.3",
      "Jinja2==3.1.6",
      "MarkupSafe==3.0.2"
    ],
    "python_package_hashes": {
      "diagrams==0.25.1": [
        "sha256:90698eaa74c027dfffd8306ba7f08ee543959205024050a6357f34eae9961345"
      ],
      "graphviz==0.20.3": [
        "sha256:81f848f2904515d8cd359cc611faba817598d2feaac4027b266aa3eda7b3dde5"
      ],
      "Jinja2==3.1.6": [
        "sha256:85ece4451f492d0c13c5dd7c13a64681a86afae63a5f347908daf103ce6d2f67"
      ],
      "MarkupSafe==3.0.2": [
        "sha256:569511d3b58c8791ab4c2e1285575265991e6d8f8700c7be0e88f86cb0672094",
        "sha256:15ab75ef81add55874e7ab7055e9c397312385bd9ced94920f2802310c930396"
      ]
    },
    "installation": {
      "resolve_dependencies": false,
      "binary_only": true,
      "require_hashes": true
    },
    "system_packages": [
      "graphviz=2.42.2-7+deb12u1"
    ],
    "dynamic_installation": false
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "spec"
    ],
    "properties": {
      "schema_version": {
        "const": "1"
      },
      "render_mode": {
        "type": "string",
        "enum": [
          "auto",
          "diagrams",
          "fallback"
        ],
        "default": "auto"
      },
      "diagram_code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000,
        "description": "Optional North-generated allowlisted Python source. If absent, the deterministic template is used; invalid supplied code fails closed."
      },
      "output_formats": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "svg",
            "png"
          ]
        },
        "uniqueItems": true,
        "minItems": 1,
        "maxItems": 2,
        "default": [
          "svg",
          "png"
        ]
      },
      "spec": {
        "$ref": "#/$defs/architecture_spec"
      }
    },
    "$defs": {
      "identifier": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "component": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "edge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/identifier"
          },
          "target": {
            "$ref": "#/$defs/identifier"
          },
          "label": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          }
        }
      },
      "boundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "component_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "component_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 64
          }
        }
      },
      "architecture_spec": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "components",
          "edges"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "provider": {
            "type": "string",
            "enum": [
              "generic",
              "aws",
              "azure",
              "gcp",
              "oci",
              "kubernetes",
              "onprem",
              "hybrid"
            ],
            "default": "generic"
          },
          "direction": {
            "type": "string",
            "enum": [
              "LR",
              "RL",
              "TB",
              "BT"
            ],
            "default": "LR"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/component"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            },
            "maxItems": 256
          },
          "boundaries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/boundary"
            },
            "maxItems": 16,
            "default": []
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "maxItems": 32,
            "default": []
          },
          "unresolved_ambiguities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "maxItems": 32,
            "default": []
          }
        }
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "status"
    ],
    "properties": {
      "schema_version": {
        "const": "1"
      },
      "status": {
        "enum": [
          "succeeded",
          "failed"
        ]
      },
      "renderer": {
        "type": "string"
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "path",
            "media_type",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "validation": {
        "type": "object"
      },
      "error": {
        "type": "object"
      }
    }
  },
  "artifact_contract": [
    {
      "name": "architecture-spec.json",
      "media_type": "application/json",
      "required": true
    },
    {
      "name": "diagram.py",
      "media_type": "text/x-python",
      "required": true
    },
    {
      "name": "architecture.svg",
      "media_type": "image/svg+xml",
      "required_when_requested": "svg"
    },
    {
      "name": "architecture.png",
      "media_type": "image/png",
      "required_when_requested": "png"
    },
    {
      "name": "validation-report.json",
      "media_type": "application/json",
      "required": true
    }
  ],
  "evaluation": {
    "cases": "evals/cases.jsonl",
    "tests": "tests",
    "minimum_pass_rate": 1.0,
    "max_repair_attempts": 2
  },
  "integrity": {
    "algorithm": "sha256",
    "scope": "concatenate each regular bundle file except metis.tool.json in bytewise relative-path order as UTF-8 relative path, NUL, file bytes, NUL",
    "content_sha256": "359a61dd8782e8cc58df71b0ed104d377510d9806f35474370909217a2064865"
  }
}
