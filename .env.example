# Metis retains the WAQIL_ prefix for configuration compatibility.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
WAQIL_HOST=127.0.0.1
WAQIL_PORT=8000
WAQIL_DATA_DIR=.data

# One or more allowlisted folders whose immediate child directories become Assets.
WAQIL_ASSET_ROOTS='["/absolute/path/to/Projects"]'

WAQIL_MODEL_BACKEND=auto
WAQIL_OLLAMA_BASE_URL=http://127.0.0.1:11434
WAQIL_PLANNER_MODEL=qwen3.6:35b-mlx
WAQIL_CODER_MODEL=north-mini-code-1.0:mlx-nvfp4
WAQIL_QUALITY_MODEL=north-mini-code-1.0:mlx-mxfp8
WAQIL_CONTEXT_WINDOW=32768
WAQIL_MAX_OUTPUT_TOKENS=8192
WAQIL_OLLAMA_KEEP_ALIVE=0

# Binary documents may be larger on disk; extracted text remains tightly bounded.
WAQIL_MAX_UPLOAD_BYTES=10485760
WAQIL_MAX_TEXT_ATTACHMENT_BYTES=65536

# Explicit tool builds run end-to-end only inside Metis's registered
# no-network/run-IO boundary. Set false to require the legacy approvals.
WAQIL_TOOL_TRUSTED_AUTO_ACTIVATION=true

# Authored-tool execution budgets. The first bounds the tool's own CPU; the
# second is the wall-clock allowance for one brokered model call it makes, which
# is host latency rather than untrusted compute and so is counted separately.
WAQIL_TOOL_AUTHORED_TIMEOUT_SECONDS=10
WAQIL_TOOL_AUTHORED_MODEL_CALL_TIMEOUT_SECONDS=300

# Cloud retrieval remains opt-in. Leave identifiers blank when disabled.
WAQIL_ALLOW_CLOUD_EMBEDDINGS=true
WAQIL_OCI_PROFILE=DEFAULT
WAQIL_OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaaoi33ny4fvy2nxlrbkn5l2t6sw6yuy5tats7iipnb5hz6jmylqqnq

# Optional alternative to entering the read-only Notion integration token in
# Knowledge. UI-entered tokens are stored locally at .data/notion.json (0600).
WAQIL_NOTION_TOKEN=

# Optional OCI Responses mode. This requires an OCI Generative AI project OCID
# in a supported Responses region. Metis keeps service-side OCI memory disabled.
WAQIL_ALLOW_OCI_RESPONSES=true
WAQIL_OCI_RESPONSES_PROJECT_ID=ocid1.generativeaiproject.oc1.us-chicago-1.amaaaaaa2xxap7ya5kqwgqnluga24egl5lnckylnwlq4obrqm5zfvoerexga
WAQIL_OCI_RESPONSES_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
WAQIL_OCI_GROK_MODEL=xai.grok-4.3

# Optional Cohere mode, keyed directly against api.cohere.com. Distinct from the
# OCI-hosted Cohere retrieval models above: this is chat, agents, and dictation.
# Absent key means the provider is simply not offered anywhere in the UI.
WAQIL_COHERE_API_KEY=
WAQIL_COHERE_MODEL=command-a-plus-05-2026
WAQIL_COHERE_MAX_OUTPUT_TOKENS=8192

# Dictation, on the same key. The composer's microphone posts one recording to
# Cohere Transcribe and puts the text in your draft; nothing is stored on either
# side. The size ceiling is Cohere's own, restated so an oversized clip is
# refused before it is read into memory rather than after a round trip.
# cohere-transcribe-arabic-07-2026 is the Arabic model.
WAQIL_COHERE_TRANSCRIBE_MODEL=cohere-transcribe-03-2026
WAQIL_COHERE_TRANSCRIBE_LANGUAGE=en
WAQIL_COHERE_TRANSCRIBE_MAX_BYTES=26214400

# Reviewed verification checks. A project declares its own checks in
# .metis/verify.json; the agent may only name one, and you approve the recipe
# once by fingerprint. These run as your own account, not in the sandbox.
WAQIL_PROJECT_VERIFY_ENABLED=true
WAQIL_PROJECT_VERIFY_TIMEOUT_SECONDS=300
WAQIL_PROJECT_VERIFY_OUTPUT_CHARS=12000
WAQIL_PROJECT_VERIFY_MAX_RUNS=6

# Completed runs become local Markdown under .data/corpus/runs and register a
# "Run history" corpus source. The documents are always local; indexing them
# still requires granting that source consent in Knowledge.
WAQIL_RUN_HISTORY_ENABLED=true
WAQIL_RUN_HISTORY_MAX_CHARS=12000

# Durable facts suggested from a finished run. They are always proposals and
# never become active memory without your approval.
WAQIL_MEMORY_HARVEST_ENABLED=true
WAQIL_MEMORY_HARVEST_MAX_CANDIDATES=3

LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# Retire tools by slug: routing skips them entirely and the request gets a
# direct answer instead. JSON list form.
# WAQIL_TOOL_DISABLED_SLUGS=["model-benchmark-researcher"]
