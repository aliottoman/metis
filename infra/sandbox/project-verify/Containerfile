FROM docker.io/library/python:3.13.5-slim-bookworm@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419

LABEL org.opencontainers.image.title="Metis project verify sandbox" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.description="Offline importer and smoke tester for freshly built projects" \
      org.opencontainers.image.base.name="docker.io/library/python:3.13.5-slim-bookworm" \
      org.opencontainers.image.base.digest="sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419"

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

COPY infra/sandbox/project-verify/requirements.lock /tmp/requirements.lock

# The curated set a generated project may import offline. Anything outside it is
# reported by the host as unavailable in this image, never as a code defect.
RUN python -m pip install \
        --no-compile \
        --only-binary=:all: \
        --require-hashes \
        --requirement /tmp/requirements.lock \
    && rm /tmp/requirements.lock \
    && python -c 'import fastapi, httpx, pydantic, sqlalchemy, pypdf, openai, starlette.testclient' \
    && python -c 'from oci_genai_auth import OciUserPrincipalAuth'

RUN groupadd --gid 65532 metis \
    && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin metis \
    && mkdir -p /opt/metis/verify /input \
    && chown -R 65532:65532 /opt/metis/verify /input

WORKDIR /opt/metis/verify

COPY --chown=65532:65532 infra/sandbox/project-verify/verify_tool.py /opt/metis/verify/verify_tool.py

USER 65532:65532

ENTRYPOINT ["python", "/opt/metis/verify/verify_tool.py"]
