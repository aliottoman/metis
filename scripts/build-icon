#!/bin/zsh
# Generate ApplicationIcon.icns from the product icon artwork.
#
# The artwork is Ali's chosen mark — "The Tessera" (round 14 of the logo
# exploration): a single folded shape, several capabilities resolving into
# one object, on the paper tile. The SVG is committed at
# apps/mac/Resources/metis-tessera.svg and rasterized here with
# rsvg-convert, so the dock icon can never drift from that file without a
# diff showing it. Run this after changing the artwork; scripts/build-app
# packages the committed .icns.
set -euo pipefail

ROOT="${0:A:h:h}"
SVG="$ROOT/apps/mac/Resources/metis-tessera.svg"
OUT="$ROOT/apps/mac/Resources/ApplicationIcon.icns"
command -v rsvg-convert >/dev/null || { print "rsvg-convert missing (brew install librsvg)"; exit 1; }
[[ -f $SVG ]] || { print "icon artwork missing: $SVG"; exit 1; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

ICONSET="$WORK/Metis.iconset"
mkdir -p "$ICONSET"
for size in 16 32 128 256 512; do
	rsvg-convert -w $size -h $size "$SVG" -o "$ICONSET/icon_${size}x${size}.png"
	double=$((size * 2))
	rsvg-convert -w $double -h $double "$SVG" -o "$ICONSET/icon_${size}x${size}@2x.png"
done
iconutil -c icns "$ICONSET" -o "$OUT"
print "[build-icon] wrote $OUT ($(du -h "$OUT" | cut -f1 | tr -d ' ')) from ${SVG:t}"
